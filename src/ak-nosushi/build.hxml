# No Sushi (Arkadeo) - port Haxe 3 de KotionTwin. Depuis ce dossier : haxe build.hxml (Haxe 3.4.7)
-cp src
-cp stub
-cp lib
-swf ../../games/ak-nosushi/game.swf
